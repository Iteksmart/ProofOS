DATABASE_URL=postgresql+psycopg://proofos:proofos@localhost:5432/proofos
ENV=development
POSTGRES_USER=proofos
POSTGRES_PASSWORD=CHANGE-ME-use-a-random-64-character-hex-secret
POSTGRES_DB=proofos
JWT_SECRET=change-me-32chars-min
JWT_ALGO=HS256
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173
WEB_URL=http://localhost:5173
VITE_API_URL=
# Set these only after authorizing the matching OAuth callback in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/sso/google/callback
PROOF_SIGNING_SEED_HEX=
# Agent auth (shared secret for agents) — REQUIRED in production
AGENT_TOKEN=
# Allow unauthenticated /v1/auth/bootstrap (first-run org+admin) — set false in production
ALLOW_BOOTSTRAP=true
# AI copilot backend: heuristic (offline, deterministic) | omniroute (LLM gateway) | openrouter (hosted free LLM models)
AI_PROVIDER=heuristic
OMNIROUTE_URL=http://localhost:20128
OMNIROUTE_KEY=
OMNIROUTE_MODEL=auto
# OpenRouter (https://openrouter.ai) — free-tier models use the ":free" suffix
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_REFERER=https://proofos.local
# iTechSmart UAIO integration (ProofLink / ProofLink Plus / MCP / Ledger)
ITECHSMART_MCP_URL=http://127.0.0.1:3200
ITECHSMART_PROOFLINK_URL=http://127.0.0.1:8004
ITECHSMART_PROOFLINK_PLUS_URL=http://127.0.0.1:8610
ITECHSMART_LEDGER_URL=http://127.0.0.1:8064
ITECHSMART_API_KEY=
# Microsoft 365 Graph (application permissions + tenant admin consent required)
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
# Google Workspace Admin Directory (service account with domain-wide delegation)
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_FILE=
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_JSON=
GOOGLE_WORKSPACE_ADMIN_EMAIL=
GOOGLE_WORKSPACE_CUSTOMER_ID=my_customer
# AWS EC2 (uses the standard AWS credential chain / instance role)
AWS_REGION=
AWS_PROFILE=
# Azure Resource Manager (service principal with VM Reader or equivalent)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
# VMware vCenter (read-only inventory account; CA file optional for private PKI)
VMWARE_BASE_URL=
VMWARE_USERNAME=
VMWARE_PASSWORD=
VMWARE_CA_BUNDLE=
# Open-source remote desktop (MeshCentral is part of the compose stack)
MESHCENTRAL_URL=https://localhost:8096
MESHCENTRAL_IMAGE=
VNC_PORT=5900
MESHCENTRAL_WEB_BIND_IP=127.0.0.1
MESHCENTRAL_AGENT_BIND_IP=127.0.0.1
# Firebase Cloud Messaging (push notifications)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
# Production/host network settings (choose a non-conflicting private subnet if needed)
PROOFOS_WEB_SUBNET=172.31.240.0/24
PROOFOS_WEB_PROXY_IP=172.31.240.2
# Set PROOFOS_ALLOW_BOOTSTRAP=true in the Compose shell only for first-run production setup.
PROOFOS_ALLOW_BOOTSTRAP=
